// Slug normalizer
export function slugify(nome) {
  return nome
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/\s+/g, '-')
    .replace(/[^a-z0-9-]/g, '')
}

export function useBairroLanding(slug) {
  const data = BAIRROS_DATA[slug] || null
  return { data }
}

export { BAIRROS_DATA }
