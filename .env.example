# Google Analytics 4
GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_API_SECRET=your_api_secret_here

# Measurement Protocol API
# Usado para enviar eventos do servidor para o GA4
# Como obter:
# 1. Acesse Google Analytics > Admin > Fluxos de dados
# 2. Clique no seu fluxo de dados
# 3. Role até "Measurement Protocol API secrets"
# 4. Crie uma nova chave secreta
# 5. Copie o valor e cole aqui

# Supabase Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# E-mail (Resend API — legado, não utilizado atualmente)
RESEND_API_KEY=your_resend_api_key

# Gmail SMTP — Notificação de Leads
# Remetente e credenciais SMTP para envio de notificações
# Usar senha de aplicativo Gmail (16 caracteres, sem espaços)
# Gerar em: https://myaccount.google.com/apppasswords
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Destinatário das notificações de leads (opcional)
# Se não definido, usa GMAIL_EMAIL como destinatário
LEAD_NOTIFICATION_EMAIL=

# Cloudflare R2 Private Storage — Mídia de Leads
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_LEADS_BUCKET_NAME=adtelas-leads-private

# Token de Upload Assinado (HMAC-SHA256) — Segredo exclusivo server-side
# NUNCA reutilizar chaves do Supabase, R2 ou Gmail
MEDIA_UPLOAD_SIGNING_SECRET=your_dedicated_media_upload_signing_secret_here

# Cloudflare R2 Public Storage — Mídias do Site / Galerias Públicas
R2_SITE_MEDIA_ACCOUNT_ID=your_cloudflare_account_id
R2_SITE_MEDIA_ACCESS_KEY_ID=your_site_media_access_key_id
R2_SITE_MEDIA_SECRET_ACCESS_KEY=your_site_media_secret_access_key
R2_SITE_MEDIA_BUCKET_NAME=adtelas-site-media
R2_SITE_MEDIA_PUBLIC_BASE_URL=https://media.adtelasmosquiteiras.com.br
R2_SITE_MEDIA_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com



